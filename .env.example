# Groq is the only LLM provider in this project.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Docker Compose uses this default.
REDIS_URL=redis://redis:6379/0
JOB_QUEUE_KEY=ia-entrega-7:queue

# Optional: LangSmith observability. Cost attribution is calculated by LangSmith.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ia-entrega-7
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

MAX_ITERATIONS=6
